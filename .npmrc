# react-native-worklets' native (CMake/ninja) build overflows Windows' path
# length limit under pnpm's default deeply-nested .pnpm virtual store
# (node_modules/.pnpm/<pkg>@<version>_<hash>/node_modules/<pkg>/android/.cxx/...).
# Hoisted mode gives a flat node_modules instead, short enough to build.
node-linker=hoisted
