# react-native-worklets' native (CMake/ninja) build overflows Windows' path
# length limit under pnpm's default deeply-nested .pnpm virtual store
# (node_modules/.pnpm/<pkg>@<version>_<hash>/node_modules/<pkg>/android/.cxx/...).
# Hoisted mode gives a flat node_modules instead, short enough to build.
node-linker=hoisted
# CMake/ninja still resolves symlinked packages back to their real path in
# the .pnpm store, so hoisting alone isn't enough once a package's version+
# hash suffix pushes the object-file path past Windows' ~250-char CMake
# limit (hit by react-native-worklets). Relocating the store itself outside
# the repo's own long path shaves off the fixed prefix.
virtual-store-dir=../pnpm-vs
