EXPO_PUBLIC_API_URL=http://localhost:3000
# The web app's URL — password reset links always open in a browser, even
# when the flow is started from the mobile app.
EXPO_PUBLIC_WEB_APP_URL=http://localhost:3000
# RevenueCat public API keys, one per store — from the RevenueCat dashboard
# (Project settings > API keys). Safe to expose client-side.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
